# =============================================================================
# Speakle Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# Server
NODE_ENV=development
PORT=3002
API_URL=http://localhost:3002
WEB_URL=http://localhost:5173

# Database
# Local dev: SQLite file path (relative to apps/api/)
DATABASE_PATH=./speakle.db
# Production (Vercel): Turso database — get from turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Auth — generate a strong random secret: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3001

# Encryption key for AI API keys stored in DB (32 bytes hex)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change-me-to-64-hex-chars-for-32-bytes

# AI Providers (optional — can also be set via admin UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Tavily Search API (for AI research feature)
TAVILY_API_KEY=

# File uploads
# Local dev: local disk path
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
# Production (Vercel): Vercel Blob — added automatically when you add Blob storage in Vercel dashboard
BLOB_READ_WRITE_TOKEN=
