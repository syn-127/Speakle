{
  "name": "speakle",
  "version": "1.0.0",
  "description": "AI-powered blog platform",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "dev:api": "pnpm --filter @speakle/api run dev",
    "dev:web": "pnpm --filter @speakle/web run dev",
    "build": "pnpm -r run build",
    "build:api": "pnpm --filter @speakle/api run build",
    "build:web": "pnpm --filter @speakle/web run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore",
    "db:generate": "DATABASE_PATH=$(pwd)/apps/api/speakle.db pnpm --filter @speakle/db run generate",
    "db:migrate": "DATABASE_PATH=$(pwd)/apps/api/speakle.db pnpm --filter @speakle/db run migrate",
    "db:studio": "DATABASE_PATH=$(pwd)/apps/api/speakle.db pnpm --filter @speakle/db run studio",
    "db:seed": "pnpm --filter @speakle/db run seed",
    "bundle:api": "esbuild apps/api/server.ts --bundle --platform=node --target=node18 --format=esm --outfile=api/handler.mjs --external:better-sqlite3 --external:@libsql/client --external:libsql --log-level=info",
    "test": "pnpm -r run test",
    "clean": "pnpm -r run clean && find . -name 'node_modules' -not -path '*/.git/*' -prune -exec rm -rf {} +"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/openai": "^1.3.24",
    "@libsql/client": "^0.17.3",
    "@paralleldrive/cuid2": "^2.3.1",
    "@vercel/blob": "^2.4.0",
    "ai": "^4.3.19",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.9.1",
    "drizzle-orm": "^0.38.4",
    "zod": "^3.25.76"
  }
}
