{
  "framework": null,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @speakle/web build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
