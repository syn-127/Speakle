{
  "framework": null,
  "outputDirectory": "dist",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @speakle/web build && pnpm -w run bundle:api",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
